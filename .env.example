# =============================================================================
# Database configuration (PostgreSQL)
# =============================================================================
# Copia este archivo a .env y rellena tus credenciales.
#
# QUE BASE USA LA APP (cambia el perfil, no la URL):
#   Sin perfil activo  ->  NEON              (variables DB_*)
#   Perfil "local"     ->  PostgreSQL local  (variables LOCAL_DB_*)

# --- NEON (base por defecto) ---
# Usa el host "-pooler." de Neon, el recomendado para aplicaciones.
# NO anadas `channel_binding`: el driver JDBC de PostgreSQL no lo soporta.
DB_URL=jdbc:postgresql://ep-xxx-pooler.<region>.aws.neon.tech:5432/<DB>?sslmode=require
# Usuario de la base de datos (rol real de PostgreSQL).
DB_USERNAME=usuario
# Contrasena de la base de datos.
DB_PASSWORD=password

# --- PostgreSQL LOCAL (perfil "local") ---
# Solo si tienes Postgres corriendo en tu maquina.
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/beautymanager
LOCAL_DB_USERNAME=usuario_local
LOCAL_DB_PASSWORD=password_local

# =============================================================================
# JWT Configuration
# =============================================================================
# Secret key for signing JWT tokens (HS256).
# Debe ser una cadena segura de al menos 32 caracteres.
# Genera una clave segura: openssl rand -hex 32
JWT_SECRET=change-this-with-a-secure-32-byte-secret

# Token expiration in milliseconds
# Tiempo de expiración del token en milisegundos (24 horas = 86400000)
JWT_EXPIRATION=86400000

# Application configuration (optional)
# Configuración de la aplicación (opcional)
# URL base del frontend, usada para CORS y rutas del backend
API_URL=http://localhost:5173
