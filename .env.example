# =============================================================================
# Database configuration (PostgreSQL)
# =============================================================================
# Local: jdbc:postgresql://localhost:5432/beautymanager
# Neon:  jdbc:postgresql://usuario:password@ep-xxx.region.aws.neon.tech/BEAUTYMANAGER?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/beautymanager
# Usuario de la base de datos (rol real de PostgreSQL).
DB_USERNAME=postgres
# Contrasena de la base de datos.
DB_PASSWORD=postgres

# =============================================================================
# JWT Configuration
# =============================================================================
# Secret key for signing JWT tokens (HS256).
# Debe ser una cadena segura de al menos 32 caracteres.
# Genera una clave segura: openssl rand -hex 32
JWT_SECRET=change-this-with-a-secure-32-byte-secret

# Token expiration in milliseconds
# Tiempo de expiración del token en milisegundos (24 horas = 86400000)
JWT_EXPIRATION=86400000

# Application configuration (optional)
# Configuración de la aplicación (opcional)
# URL base del frontend, usada para CORS y rutas del backend
API_URL=http://localhost:5173
